# Anthropic API Key（服务端持有，永远不要下发到客户端）
ANTHROPIC_API_KEY=sk-ant-...

# 用自建网关/中转时：填 AUTH_TOKEN + BASE_URL，代替 API_KEY
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 访问网关的 Bearer Token（客户端请求头 Authorization: Bearer <token>）
# 留空 = 不鉴权（仅限本机开发）
GATEWAY_TOKEN=

# 默认模型；skill 的 frontmatter 里可用 model 字段按 skill 覆盖
AGENT_MODEL=claude-opus-5-5

PORT=8787
# skill 目录（SKILL.md 所在的父目录），默认 ./skills
SKILLS_DIR=
